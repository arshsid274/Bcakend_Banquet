MONGODB_URI=mongodb://127.0.0.1:27017/budha-avenue
PORT=5001
# Use a long, random value. Configure this same value as an HTTP credential in Dograh.
DOGRAH_CRM_WEBHOOK_SECRET=replace-with-a-long-random-secret
# The existing booking service. Override this after moving booking APIs into this backend.
BOOKING_API_URL=https://budha-avenue-backend.vercel.app/api
